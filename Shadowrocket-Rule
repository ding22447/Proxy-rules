# ============================================================

DOMAIN-SUFFIX,push.apple.com,DIRECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Apple/Apple.list,Apple


# ============================================================
# 国内 / 兜底
# ============================================================

GEOIP,CN,Direct
FINAL,Final


[Host]
localhost = 127.0.0.1
localhost.weixin.qq.com = 127.0.0.1
