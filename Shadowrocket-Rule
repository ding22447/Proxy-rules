# ============================================================
# TikTok / Telegram
# ============================================================

RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/TikTok/TikTok.list,TikTok,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Telegram/Telegram.list,Telegram,force-remote-dns


# ============================================================
# Google
# ============================================================

RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/Google/Google.list,Google,force-remote-dns


# ============================================================
# Microsoft
# 默认 Direct，不强制远程 DNS。
